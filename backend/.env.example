# Local defaults: SQLite, development cookies, sample accounts and campus data.
APP_ENV=development
DEMO_ENABLED=1
DEMO_DATA_ENABLED=1

# Set a new PostgreSQL database URL for hosted production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Cloud deployment: APP_ENV=production; use environment variables for secrets.
# For all three demo accounts on a clean production database, enable DEMO_ENABLED
# and supply DEMO_ADMIN_PASSWORD, DEMO_STAFF_PASSWORD and DEMO_ATTENDEE_PASSWORD.
